# El SW nunca debe quedar cacheado: así las correcciones llegan a todos.
/sw.js
  Cache-Control: no-cache

# Cambian de contenido sin cambiar de nombre.
/manifest.json
  Cache-Control: no-cache

# Nombres con hash: nunca cambian, se cachean un año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Iconos sin hash: un día.
/icons/*
  Cache-Control: public, max-age=86400

# Seguridad (aplica a todo).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self' data:; connect-src 'self' https://dacate-backend.onrender.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'